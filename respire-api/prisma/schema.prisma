datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model ContactMessage {
  id         Int      @id @default(autoincrement())
  firstname  String
  lastname   String
  email      String
  phone      String?      // optionnel
  offer      String?      // optionnel
  message    String
  createdAt  DateTime @default(now())
}
